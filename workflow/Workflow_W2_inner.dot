/*
 * Workflow_W2_inner.dot
 *
 * Inner ("W2") workflow: the OpenRefine steps behind facility_type_lookup.csv
 * and city_lookup.csv. Grouped from the 115 raw operations in
 * ../openrefine/OpenRefineHistory.json (op counts confirmed by parsing that file
 * directly, not hand-counted) rather than generated with the OR2YW tool.
 *
 * Facility Type: 1 column-addition + 3 text-transform + 98 mass-edit (cluster merge) ops
 * City:          1 column-addition/rename + 3 text-transform + 8 mass-edit (cluster merge) ops
 *
 * Render with:
 *   dot -Tpng Workflow_W2_inner.dot -o Workflow_W2_inner.png
 *   dot -Tpdf Workflow_W2_inner.dot -o Workflow_W2_inner.pdf
 */

digraph OpenRefineInnerWorkflow {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    node [shape=box, style="rounded,filled", fillcolor="#F5F5F5", color="#999999"];
    raw_col_ft [label="Facility Type\n(521 distinct raw values)"];
    raw_col_city [label="City\n(90 distinct raw values)"];
    out_ft [label="Canonicalized Facility Type\n(240 distinct values)"];
    out_city [label="Canonicalized City\n(70 distinct values, 2 hand-\ncorrected post-export - see\nfacility_type_city/README.md)"];

    node [shape=box, style="rounded,filled", fillcolor="#EAF2FB", color="#2E5C8A", penwidth=1.4];

    subgraph cluster_ft {
        label="Facility Type lane";
        style="dashed"; color="#B98900"; fontsize=10;
        add_ft [label="core/column-addition\ncreate 'Canonicalized Facility Type'"];
        tt_ft [label="core/text-transform x3\ntoTitlecase() . trim() .\ncollapse whitespace"];
        cluster_ft_op [label="core/mass-edit x98\ncluster & merge\n(key collision / nearest-neighbor)"];
        add_ft -> tt_ft -> cluster_ft_op;
    }

    subgraph cluster_city {
        label="City lane";
        style="dashed"; color="#B98900"; fontsize=10;
        add_city [label="core/column-addition + rename\ncreate 'Canonicalized City'"];
        tt_city [label="core/text-transform x3\ntoTitlecase() . trim() .\ncollapse whitespace"];
        cluster_city_op [label="core/mass-edit x8\ncluster & merge"];
        add_city -> tt_city -> cluster_city_op;
    }

    export [label="Export project\n(row-level, 298,869 rows)"];
    dedupe [label="dedupe_lookup_tables.py\nreshape to one row per\ndistinct raw value + QA fix"];

    raw_col_ft -> add_ft;
    raw_col_city -> add_city;
    cluster_ft_op -> export;
    cluster_city_op -> export;
    export -> dedupe;
    dedupe -> out_ft;
    dedupe -> out_city;
}
